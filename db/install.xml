<XMLDB PATH="local/reviewworkflow/db" VERSION="20261028" COMMENT="Review workflow tables">
  <TABLES>
    <TABLE NAME="local_reviewworkflow_cfg" COMMENT="Review workflow cfg">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="cmid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="enabled" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="backlog" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="" />
        <FIELD NAME="instructions" TYPE="text" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="certification" TYPE="text" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="timemodified" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmid" UNIQUE="true" FIELDS="cmid" />
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_reviewworkflow_map" COMMENT="Review workflow map">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="cmid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="studentid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="reviewerid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="mapping" UNIQUE="true" FIELDS="cmid, studentid, reviewerid" />
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_reviewworkflow_req" COMMENT="Review workflow req">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="cmid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="studentid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="submissionid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="attempt" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="versionhash" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="64" DEFAULT="" />
        <FIELD NAME="state" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="32" DEFAULT="" />
        <FIELD NAME="claimedby" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="decision" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="32" DEFAULT="" />
        <FIELD NAME="comments" TYPE="text" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="certification" TYPE="text" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="certified" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="completedby" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="timecompleted" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="timemodified" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="version" UNIQUE="true" FIELDS="cmid, studentid, versionhash" />
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_reviewworkflow_msg" COMMENT="Review workflow msg">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="requestid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="recipientid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="kind" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="32" DEFAULT="" />
        <FIELD NAME="state" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="32" DEFAULT="" />
        <FIELD NAME="messageid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="error" TYPE="text" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="timemodified" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="notice" UNIQUE="true" FIELDS="requestid, recipientid, kind" />
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_reviewworkflow_log" COMMENT="Review workflow log">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="requestid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="actorid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
        <FIELD NAME="action" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="32" DEFAULT="" />
        <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="audit" UNIQUE="true" FIELDS="id, requestid" />
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>